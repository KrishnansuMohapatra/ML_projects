# SQL Injection Detector API — environment template
# Copy to `.env` and edit. Every value is optional; the defaults below are used
# when a variable is absent. Prefix: SQLI_

# ---------------------------------------------------------------- app
SQLI_ENVIRONMENT=development        # development | staging | production
SQLI_LOG_LEVEL=INFO
SQLI_API_V1_PREFIX=/api/v1

# -------------------------------------------------------------- model
# Relative paths resolve against the project root.
SQLI_MODEL_PATH=models/sql_injection_model_v4.pkl
SQLI_MODEL_NAME=sql-injection-detector-v4
SQLI_DECISION_THRESHOLD=0.5         # 0.0 - 1.0

# ------------------------------------------------------------- limits
SQLI_MAX_QUERY_LENGTH=10000
SQLI_MAX_BATCH_SIZE=500
SQLI_MAX_FILE_SIZE_MB=10
SQLI_MAX_FILE_ROWS=5000

# ----------------------------------------------------------- security
# Comma-separated API keys. Leave empty to disable auth entirely.
SQLI_API_KEYS=
# Requests per minute per key (0 disables rate limiting).
SQLI_RATE_LIMIT_PER_MINUTE=0
# Comma-separated allowed origins, or "*" for any.
SQLI_CORS_ORIGINS=*

# Enables POST /api/v1/admin/reload (still requires an API key).
SQLI_ALLOW_MODEL_RELOAD=false
